# Same names as fastmcp-rag-timer-frontend. Copy those Railway values locally.
# Never commit the filled-in file. The browser never receives these secrets.
MCP_SERVER_URL=https://rag-timer-00001-production.up.railway.app/mcp/
MCP_API_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=you@example.com
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=http://127.0.0.1:8000

HOST=0.0.0.0
PORT=8000

# DeepL key for translating dynamic page content (reply, facts, MCP descriptions).
# Free keys end with :fx and use api-free.deepl.com unless DEEPL_API_URL is set.
DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com
